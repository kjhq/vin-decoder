{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vin-decoder",
  "main": "workers/asset-cache.js",
  "compatibility_date": "2026-07-17",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "vin.kjhq.dev", "custom_domain": true }
  ]
}
